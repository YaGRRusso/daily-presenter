{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noEnum": "off",
        "noMagicNumbers": "off",
        "noParameterProperties": "off"
      }
    }
  }
}
